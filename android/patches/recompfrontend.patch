diff --git a/recompui/src/renderer/rt64_render_context.cpp b/recompui/src/renderer/rt64_render_context.cpp
index a7954c7..d0fbc20 100644
--- a/recompui/src/renderer/rt64_render_context.cpp
+++ b/recompui/src/renderer/rt64_render_context.cpp
@@ -1,3 +1,10 @@
+#if defined(__ANDROID__)
+#include <SDL.h>
+#include <SDL_syswm.h>
+#include <android/native_window.h>
+#include "android_support.h"
+#include "android_window_handoff.h"
+#endif
 #include <memory>
 #include <cstring>
 #include <variant>
@@ -225,7 +232,14 @@ renderer::RT64Context::RT64Context(uint8_t* rdram, ultramodern::renderer::Window
     RT64::Application::Core appCore{};
 #if defined(_WIN32)
     appCore.window = window_handle.window;
-#elif defined(__linux__) || defined(__ANDROID__)
+#elif defined(__ANDROID__)
+    SDL_SysWMinfo info{};
+    SDL_VERSION(&info.version);
+    if (!SDL_GetWindowWMInfo(window_handle, &info)) {
+        throw std::runtime_error("Cannot obtain Android native window");
+    }
+    appCore.window = info.info.android.window;
+#elif defined(__linux__)
     appCore.window = window_handle;
 #elif defined(__APPLE__)
     appCore.window.window = window_handle.window;
@@ -356,6 +370,11 @@ void renderer::RT64Context::send_dummy_workload(uint32_t fb_address) {
 }
 
 void renderer::RT64Context::update_screen() {
+#if defined(__ANDROID__)
+    if (auto* native = static_cast<ANativeWindow*>(bmhero::android::take_window())) {
+        bmhero::android::handoff_window(native, app ? app->swapChain.get() : nullptr, ANativeWindow_release);
+    }
+#endif
     check_refresh_rate_changes();
     app->updateScreen();
 }
